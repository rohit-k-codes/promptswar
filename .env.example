# ==============================================================================
# Explore City — Pune Edition: Single Gemini API Key Architecture
# Tagline: Less Survival Mode. More Adventure.
# City: Pune, Maharashtra, India
# ==============================================================================
# 
# ZERO PAID APIS REQUIRED.
# The only external API credential needed by this application is GEMINI_API_KEY.
# 
# NO Google Maps Platform key needed (Uses Leaflet + OpenStreetMap)
# NO Weather API key needed (Uses Open-Meteo free keyless meteorological data)
# NO Supabase or database credentials needed (Uses versioned browser localStorage)
# NO OpenAI or Anthropic keys needed
# ==============================================================================

# 1. Google Gemini API (Backend Only)
# Obtain free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 2. Supported Gemini Model (Default: gemini-3.8-flash)
# Free-tier supported model for fast, multimodal reasoning and planning
GEMINI_MODEL=gemini-3.8-flash

# 3. Backend Express Server Port
PORT=3001
