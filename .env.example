# ==============================================================================
# Explore City — Environment Variables Configuration
# Tagline: Less Survival Mode. More Adventure.
# ==============================================================================

# 1. Supabase Cloud Configuration (PostgreSQL, Auth & Storage)
# Obtain from https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Google Maps Platform APIs
# Enable: Maps JavaScript API, Places API (New), Routes API
# Obtain from https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 3. Google Gemini API (Trip Planning & Citizen Safety Intelligence)
# Obtain from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key

# 4. Optional Weather API (Defaults to coastal meteorological model if omitted)
# Obtain from https://openweathermap.org/api
VITE_WEATHER_API_KEY=your-weather-api-key
